---
// site/src/components/Footer.astro - Starlight's footer plus one quiet link
// to the "Off the record" page (light jokes and quotes). The link is here
// and in no menu, so the main pages keep their formal tone.
// Overriding a component: https://starlight.astro.build/guides/overriding-components/
import Default from '@astrojs/starlight/components/Footer.astro';
import { LOCALES } from '../../i18n.mjs';
import uiByLocale from '../generated/ui.json';

const { lang } = Astro.locals.starlightRoute;
const locale = LOCALES.find((l) => l.tag === lang) || LOCALES[0];
const { strings: ui } = uiByLocale[locale.tag as keyof typeof uiByLocale];
const href = import.meta.env.BASE_URL.replace(/\/?$/, '/') + [locale.dir, 'off-the-record'].filter(Boolean).join('/') + '/';
---

<Default><slot /></Default>
<p class="footer-extra"><a href={href}>{ui['footer.offTheRecord']}</a></p>
