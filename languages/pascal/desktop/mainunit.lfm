object MainForm: TMainForm
  Left = 300
  Height = 160
  Top = 200
  Width = 320
  Caption = 'Hello, World!'
  Position = poScreenCenter
  OnShow = FormShow
  object HelloLabel: TLabel
    Align = alClient
    Alignment = taCenter
    Layout = tlCenter
