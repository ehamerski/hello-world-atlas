<?xml version="1.0" encoding="UTF-8"?>
<!-- hello.lpi - Lazarus project for the Delphi-dialect desktop program.
     Lazarus reads this file (lazbuild does too). The layout follows the
     Lazarus example projects in examples/pen_brush/project1.lpi of Lazarus 4.8.
     LCLWidgetType=cocoa selects the Cocoa widget set (macOS). -->
<CONFIG>
  <ProjectOptions>
    <Version Value="12"/>
    <General>
      <Flags>
        <MainUnitHasCreateFormStatements Value="False"/>
        <MainUnitHasTitleStatement Value="False"/>
        <MainUnitHasScaledStatement Value="False"/>
      </Flags>
      <SessionStorage Value="InProjectDir"/>
      <Title Value="hello"/>
    </General>
    <BuildModes Count="1">
      <Item1 Name="Default" Default="True"/>
      <SharedMatrixOptions Count="1">
        <Item1 ID="754211134008" Type="IDEMacro" MacroName="LCLWidgetType" Value="cocoa"/>
      </SharedMatrixOptions>
    </BuildModes>
    <RequiredPackages Count="1">
      <Item1>
        <PackageName Value="LCL"/>
      </Item1>
    </RequiredPackages>
    <Units Count="1">
      <Unit0>
        <Filename Value="hello.lpr"/>
        <IsPartOfProject Value="True"/>
      </Unit0>
    </Units>
  </ProjectOptions>
  <CompilerOptions>
    <Version Value="11"/>
    <Target>
      <Filename Value="build/hello"/>
    </Target>
    <Parsing>
      <SyntaxOptions>
        <SyntaxMode Value="Delphi"/>
      </SyntaxOptions>
    </Parsing>
  </CompilerOptions>
</CONFIG>
