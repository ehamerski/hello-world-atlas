--  hello.gpr - GNAT project file: tells gprbuild how to build this program.
--  Created by "alr init"; the syntax looks like Ada on purpose.
--  Reference: GPRbuild User's Guide, "GNAT Project Manager"
--  https://docs.adacore.com/gprbuild-docs/html/gprbuild_ug/gnat_project_manager.html

--  Settings that Alire generates from alire.toml on every "alr build"
--  (build profile, compiler switches such as -gnat2022).
with "config/hello_config.gpr";
project Hello is

   --  Where the Ada sources are.
   for Source_Dirs use ("src/", "config/");
   --  Where compiled units go (obj/development by default).
   for Object_Dir use "obj/" & Hello_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   --  Where the executable goes.
   for Exec_Dir use "bin";
   --  The main subprogram: the procedure in this file is the program.
   for Main use ("hello.adb");

   package Compiler is
      for Default_Switches ("Ada") use Hello_Config.Ada_Compiler_Switches;
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

   package Install is
      for Artifacts (".") use ("share");
   end Install;

end Hello;
